{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TradingView Strategy Result",
  "description": "Normalised schema for TradingView Strategy Tester export results. Unknown fields must be null — never zero.",
  "type": "object",
  "required": ["schema_version", "result_id", "strategy", "symbol", "timeframe", "data_source", "period_start", "period_end", "cost_scenario", "validation_status", "total_trades"],
  "properties": {
    "schema_version":      {"type": "string"},
    "result_id":           {"type": "string", "description": "Unique result identifier: strategy_symbol_tf_period_scenario"},
    "strategy":            {"type": "string", "enum": ["HR_EMA_Pullback_Pro", "HR_Breakout_Retest_Pro", "HR_Market_Structure_Pro", "HR_VWAP_Mean_Reversion_Pro", "HR_Momentum_Volatility_Pro"]},
    "strategy_version":    {"type": ["string", "null"]},
    "parameter_version":   {"type": ["string", "null"]},
    "symbol":              {"type": "string"},
    "timeframe":           {"type": "string", "enum": ["5M", "15M", "1H", "4H"]},
    "data_source":         {"type": "string", "description": "TradingView data feed (e.g. OANDA, FOREXCOM, TVC)"},
    "period_start":        {"type": "string", "format": "date"},
    "period_end":          {"type": "string", "format": "date"},
    "period_type":         {"type": ["string", "null"], "enum": ["development", "validation", "out_of_sample", "forward", null]},
    "cost_scenario":       {"type": "string", "enum": ["A", "B", "C"]},
    "validation_status":   {"type": "string", "enum": ["SIMULATED", "NATIVE-TV-PENDING", "NATIVE-TV-VERIFIED", "OOS-VERIFIED", "FORWARD-TESTING", "PAPER-TRADING", "LIVE-ELIGIBLE", "REJECTED"]},
    "initial_capital":     {"type": ["number", "null"]},
    "commission_pct":      {"type": ["number", "null"]},
    "slippage_ticks":      {"type": ["integer", "null"]},
    "position_size_pct":   {"type": ["number", "null"]},
    "total_trades":        {"type": ["integer", "null"]},
    "net_profit":          {"type": ["number", "null"]},
    "net_profit_pct":      {"type": ["number", "null"]},
    "profit_factor":       {"type": ["number", "null"]},
    "win_rate":            {"type": ["number", "null"]},
    "average_trade":       {"type": ["number", "null"]},
    "average_win":         {"type": ["number", "null"]},
    "average_loss":        {"type": ["number", "null"]},
    "expectancy":          {"type": ["number", "null"]},
    "max_drawdown":        {"type": ["number", "null"]},
    "max_drawdown_pct":    {"type": ["number", "null"]},
    "sharpe":              {"type": ["number", "null"]},
    "sortino":             {"type": ["number", "null"]},
    "long_trades":         {"type": ["integer", "null"]},
    "short_trades":        {"type": ["integer", "null"]},
    "long_win_rate":       {"type": ["number", "null"]},
    "short_win_rate":      {"type": ["number", "null"]},
    "largest_win":         {"type": ["number", "null"]},
    "largest_loss":        {"type": ["number", "null"]},
    "max_consecutive_wins":  {"type": ["integer", "null"]},
    "max_consecutive_losses":{"type": ["integer", "null"]},
    "notes":               {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
