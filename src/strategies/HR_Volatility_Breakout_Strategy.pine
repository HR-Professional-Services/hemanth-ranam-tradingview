//@version=6
strategy("HR Volatility Expansion Breakout Pro [Strategy]", 
         shorttitle="HR-VOL-S", 
         overlay=true, 
         initial_capital=10000, 
         default_qty_type=strategy.percent_of_equity, 
         default_qty_value=1.0, 
         commission_type=strategy.commission.percent, 
         commission_value=0.02, 
         slippage=2, 
         process_orders_on_close=true, 
         max_labels_count=500, 
         max_lines_count=500)

// =============================================================================
// HR VOLATILITY EXPANSION BREAKOUT PRO — DEDICATED PINE SCRIPT V6 STRATEGY
// Product ID: HR-PRD-03
// System: HR TradingView Suite | ScaleNova / HR Professional Services
// Author: Hemanth Ranam | Developed by Antigravity Engine
//
// ALIGNMENT SPECIFICATION:
//   - Directly shares signal calculation engine with HR_Volatility_Breakout_Indicator.pine
//   - Aligned with MT5 EA: VOLATILITY_EXPANSION_BREAKOUT_EA.mq5
//   - Squeeze Detection: Box Height <= ATR * InpMaxCompressionATR (1.8)
//   - Confirmed bar execution (process_orders_on_close=true, barstate.isconfirmed)
//   - Protective Stop Loss placed at box midpoint with ATR buffer
//   - Target R:R ratio defaults to 1:2.5 matching MT5 InpRewardToRiskRatio
//
// RISK GUARDRAIL:
//   - Maximum risk per trade capped at 1.0% account equity
//   - Explicit commission (0.02%) and slippage (2 ticks) modeled
// =============================================================================

// ─────────────────────────────────────────────────────────────────────────────
// INPUT GROUPS
// ─────────────────────────────────────────────────────────────────────────────
var string GRP_GEN    = "● General Execution"
var string GRP_SQZ    = "● Volatility Compression & Squeeze"
var string GRP_VOL    = "● Volume & Expansion Filters"
var string GRP_HTF    = "● Higher-Timeframe Filter"
var string GRP_SCORE  = "● Signal Quality Scoring"
var string GRP_RISK   = "● Risk Management & Targets"
var string GRP_DASH   = "● Dashboard & Telemetry"
var string GRP_VIS    = "● Visual Settings"

// ─── GENERAL EXECUTION ───────────────────────────────────────────────────────
enableLong     = input.bool(true,  "Enable Long Trades",             group=GRP_GEN)
enableShort    = input.bool(true,  "Enable Short Trades",            group=GRP_GEN)
useDateFilter  = input.bool(false, "Enable Testing Date Filter",     group=GRP_GEN)
startDate      = input.time(timestamp("2024-01-01 00:00:00"), "Start Date", group=GRP_GEN)
endDate        = input.time(timestamp("2026-12-31 23:59:59"), "End Date",   group=GRP_GEN)

// ─── VOLATILITY COMPRESSION & SQUEEZE ────────────────────────────────────────
compressionBars   = input.int(20,    "Compression Lookback Window", minval=5, maxval=100, group=GRP_SQZ,
     tooltip="Number of bars evaluated for consolidation range box. Aligned with MT5 InpCompressionBars=20.")
maxCompressionAtr = input.float(1.8, "Max Range / ATR Ratio (Squeeze)", minval=0.5, step=0.1, group=GRP_SQZ,
     tooltip="Box height must be within this multiple of ATR to qualify as a squeeze. Aligned with MT5 InpMaxCompressionATR=1.8.")
atrLen            = input.int(14,    "ATR Period", minval=1, group=GRP_SQZ)

// ─── VOLUME & EXPANSION FILTERS ──────────────────────────────────────────────
useVolumeFilter   = input.bool(false, "Enable Volume Expansion Filter", group=GRP_VOL,
     tooltip="Default OFF for universal compatibility across forex spot feeds.")
minVolumeMult     = input.float(1.25, "Min Volume Expansion Multiplier", minval=1.0, step=0.05, group=GRP_VOL)

// ─── HIGHER-TIMEFRAME FILTER ─────────────────────────────────────────────────
useHtfFilter = input.bool(true,  "Enable HTF Trend Filter", group=GRP_HTF)
htfTF        = input.timeframe("60", "Higher Timeframe", group=GRP_HTF)
htfEmaLen    = input.int(200, "HTF Baseline EMA", minval=10, group=GRP_HTF)

// ─── SIGNAL QUALITY SCORING ──────────────────────────────────────────────────
minEntryScore  = input.int(70, "Minimum Entry Quality Score (0–100)", minval=50, maxval=95, step=5, group=GRP_SCORE)
minSignalGrade = input.string("A and Above", "Minimum Signal Grade",
     options=["A+ Only", "A and Above", "B and Above", "All Signals"], group=GRP_SCORE)

// ─── RISK MANAGEMENT & TARGETS ───────────────────────────────────────────────
slMode       = input.string("Box Midpoint", "Stop Loss Placement", 
     options=["Box Midpoint", "Candle Extreme", "Tighter of Both"], group=GRP_RISK)
slBufferAtr  = input.float(0.1,  "SL Buffer (× ATR)", minval=0.0, step=0.05, group=GRP_RISK)
rrMultiplier = input.float(2.5,  "Target Reward-to-Risk (R:R)", minval=1.0, step=0.1, group=GRP_RISK)
cooldownBars = input.int(5,      "Minimum Cooldown Bars", minval=1, maxval=50, group=GRP_RISK)

// ─── DASHBOARD & VISUALS ─────────────────────────────────────────────────────
showHud         = input.bool(true,  "Display Telemetry HUD",       group=GRP_DASH)
hudPos          = input.string("Top Right", "HUD Position",
     options=["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group=GRP_DASH)
showBoxes       = input.bool(true,  "Plot Squeeze Box Lines",      group=GRP_VIS)
showTradeLabels = input.bool(true,  "Show Entry Markers",          group=GRP_VIS)

// =============================================================================
// CALCULATIONS & INDICATOR VALUES
// =============================================================================
atr = ta.atr(atrLen)

// HTF Security Request (Strict [1] indexing and lookahead_off)
htfClose  = request.security(syminfo.tickerid, htfTF, close[1], barmerge.gaps_off, barmerge.lookahead_off)
htfEma200 = request.security(syminfo.tickerid, htfTF, ta.ema(close, htfEmaLen)[1], barmerge.gaps_off, barmerge.lookahead_off)
htfBullOk = not useHtfFilter or (htfClose > htfEma200)
htfBearOk = not useHtfFilter or (htfClose < htfEma200)

// Squeeze Box
boxHigh   = ta.highest(high[1], compressionBars)
boxLow    = ta.lowest(low[1],   compressionBars)
boxHeight = boxHigh - boxLow
boxMid    = (boxHigh + boxLow) / 2.0

compressionRatio = atr > 0 ? (boxHeight / atr) : 0.0
isCompressed     = compressionRatio <= maxCompressionAtr

avgVolume      = ta.sma(volume, compressionBars)
volumeExpanded = not useVolumeFilter or na(volume) or (volume >= avgVolume * minVolumeMult)

dateWindowOk = not useDateFilter or (time >= startDate and time <= endDate)

// Breakout Conditions
bullBreakout = enableLong and (close > boxHigh) and (close > open) and isCompressed and 
               volumeExpanded and htfBullOk and barstate.isconfirmed and dateWindowOk

bearBreakout = enableShort and (close < boxLow) and (close < open) and isCompressed and 
               volumeExpanded and htfBearOk and barstate.isconfirmed and dateWindowOk

// Quality Scoring Engine
calcQualityScore(isBull) =>
    float s = 0.0
    s += compressionRatio <= 1.2 ? 35.0 : compressionRatio <= 1.5 ? 25.0 : 15.0
    float volRatio = (avgVolume > 0 and not na(volume)) ? (volume / avgVolume) : 1.0
    s += volRatio >= 1.5 ? 25.0 : volRatio >= 1.25 ? 18.0 : 10.0
    s += isBull ? (htfClose > htfEma200 ? 25.0 : 0.0) : (htfClose < htfEma200 ? 25.0 : 0.0)
    s += (high - low) >= atr ? 15.0 : 5.0
    math.min(100.0, s)

bullScore = calcQualityScore(true)
bearScore = calcQualityScore(false)

getGrade(score) =>
    score >= 90.0 ? "A+" : score >= 75.0 ? "A" : score >= 60.0 ? "B" : "C"

bullGrade = getGrade(bullScore)
bearGrade = getGrade(bearScore)

isGradeAllowed(grade) =>
    switch minSignalGrade
        "A+ Only"     => grade == "A+"
        "A and Above" => grade == "A+" or grade == "A"
        "B and Above" => grade == "A+" or grade == "A" or grade == "B"
        => true

// Cooldown & Single Entry Gate
var int lastBullBar = -100
var int lastBearBar = -100

canBull = (bar_index - lastBullBar) >= cooldownBars
canBear = (bar_index - lastBearBar) >= cooldownBars

buySignal  = bullBreakout and canBull and (bullScore >= minEntryScore) and isGradeAllowed(bullGrade)
sellSignal = bearBreakout and canBear and (bearScore >= minEntryScore) and isGradeAllowed(bearGrade)

if buySignal
    lastBullBar := bar_index
if sellSignal
    lastBearBar := bar_index

// =============================================================================
// ORDER EXECUTION & RISK MANAGEMENT
// =============================================================================
var float entryPrice = na
var float slPrice    = na
var float tpPrice    = na

longCondition  = buySignal  and strategy.position_size == 0
shortCondition = sellSignal and strategy.position_size == 0

if longCondition
    entryPrice   := close
    float baseSL = slMode == "Box Midpoint" ? boxMid : slMode == "Candle Extreme" ? low : math.max(boxMid, low)
    slPrice      := baseSL - (atr * slBufferAtr)
    riskDistance = entryPrice - slPrice
    tpPrice      := entryPrice + (riskDistance * rrMultiplier)
    
    strategy.entry("HR_Long", strategy.long)
    strategy.exit("Exit_Long", "HR_Long", stop=slPrice, limit=tpPrice)
    
    if showTradeLabels
        label.new(bar_index, low - (atr * 0.4), "BUY BREAKOUT\n" + bullGrade + " (" + str.tostring(bullScore, "#") + ")",
                  color=#2563eb, textcolor=color.white, style=label.style_label_up, size=size.small)
                  
    alert('{"brand":"Hemanth Ranam","system":"TradingView","strategy":"Volatility Expansion Breakout Pro","signal":"BUY","symbol":"' + syminfo.ticker + '","timeframe":"' + timeframe.period + '","entry":' + str.tostring(entryPrice, "#.##") + ',"stop_loss":' + str.tostring(slPrice, "#.##") + ',"take_profit_1":' + str.tostring(tpPrice, "#.##") + ',"score":' + str.tostring(bullScore, "#") + ',"grade":"' + bullGrade + '","timestamp":' + str.tostring(time) + '}', alert.freq_once_per_bar_close)

if shortCondition
    entryPrice   := close
    float baseSL = slMode == "Box Midpoint" ? boxMid : slMode == "Candle Extreme" ? high : math.min(boxMid, high)
    slPrice      := baseSL + (atr * slBufferAtr)
    riskDistance = slPrice - entryPrice
    tpPrice      := entryPrice - (riskDistance * rrMultiplier)
    
    strategy.entry("HR_Short", strategy.short)
    strategy.exit("Exit_Short", "HR_Short", stop=slPrice, limit=tpPrice)
    
    if showTradeLabels
        label.new(bar_index, high + (atr * 0.4), "SELL BREAKOUT\n" + bearGrade + " (" + str.tostring(bearScore, "#") + ")",
                  color=#dc2626, textcolor=color.white, style=label.style_label_down, size=size.small)
                  
    alert('{"brand":"Hemanth Ranam","system":"TradingView","strategy":"Volatility Expansion Breakout Pro","signal":"SELL","symbol":"' + syminfo.ticker + '","timeframe":"' + timeframe.period + '","entry":' + str.tostring(entryPrice, "#.##") + ',"stop_loss":' + str.tostring(slPrice, "#.##") + ',"take_profit_1":' + str.tostring(tpPrice, "#.##") + ',"score":' + str.tostring(bearScore, "#") + ',"grade":"' + bearGrade + '","timestamp":' + str.tostring(time) + '}', alert.freq_once_per_bar_close)

// =============================================================================
// PLOTS & TELEMETRY HUD
// =============================================================================
plot(showBoxes ? boxHigh : na, "Squeeze Box High", color=color.new(#ef4444, 40), linewidth=1, style=plot.style_stepline)
plot(showBoxes ? boxLow  : na, "Squeeze Box Low",  color=color.new(#22c55e, 40), linewidth=1, style=plot.style_stepline)
plot(showBoxes ? boxMid  : na, "Squeeze Box Mid",  color=color.new(#94a3b8, 60), linewidth=1, style=plot.style_circles)

if showHud and barstate.islast
    tablePos = hudPos == "Top Right"    ? position.top_right : 
               hudPos == "Bottom Right" ? position.bottom_right : 
               hudPos == "Top Left"     ? position.top_left : position.bottom_left
               
    var table hud = table.new(tablePos, 2, 7, bgcolor=color.new(#0f172a, 15), border_color=color.new(#334155, 30), border_width=1)
    
    table.cell(hud, 0, 0, "HEMANTH RANAM", bgcolor=color.new(#1e293b, 10), text_color=#38bdf8, text_size=size.small)
    table.cell(hud, 1, 0, "VOL BREAKOUT STRAT", bgcolor=color.new(#1e293b, 10), text_color=color.white, text_size=size.small)
    
    table.cell(hud, 0, 1, "Squeeze State", text_color=#94a3b8, text_size=size.tiny)
    table.cell(hud, 1, 1, isCompressed ? "COMPRESSED (" + str.tostring(compressionRatio, "#.##") + "x)" : "NORMAL", 
               text_color=isCompressed ? #22c55e : #94a3b8, text_size=size.tiny)
    
    table.cell(hud, 0, 2, "Box Range", text_color=#94a3b8, text_size=size.tiny)
    table.cell(hud, 1, 2, str.tostring(boxHeight, "#.##") + " pts", text_color=color.white, text_size=size.tiny)
    
    table.cell(hud, 0, 3, "Open Position", text_color=#94a3b8, text_size=size.tiny)
    table.cell(hud, 1, 3, strategy.position_size > 0 ? "LONG (" + str.tostring(strategy.position_size) + ")" : 
                          strategy.position_size < 0 ? "SHORT (" + str.tostring(strategy.position_size) + ")" : "FLAT", 
               text_color=strategy.position_size != 0 ? #f59e0b : #94a3b8, text_size=size.tiny)
               
    table.cell(hud, 0, 4, "ATR (14)", text_color=#94a3b8, text_size=size.tiny)
    table.cell(hud, 1, 4, str.tostring(atr, "#.##"), text_color=color.white, text_size=size.tiny)
    
    table.cell(hud, 0, 5, "Setup Score", text_color=#94a3b8, text_size=size.tiny)
    table.cell(hud, 1, 5, str.tostring(math.max(bullScore, bearScore), "#") + " (" + (bullScore > bearScore ? bullGrade : bearGrade) + ")", 
               text_color=#38bdf8, text_size=size.tiny)
               
    table.cell(hud, 0, 6, "Win Rate (Sim)", text_color=#94a3b8, text_size=size.tiny)
    float winRate = strategy.closedtrades > 0 ? (strategy.wintrades / strategy.closedtrades * 100.0) : 0.0
    table.cell(hud, 1, 6, strategy.closedtrades > 0 ? str.tostring(winRate, "#.#") + "% (" + str.tostring(strategy.closedtrades) + " tr)" : "N/A", 
               text_color=color.white, text_size=size.tiny)
