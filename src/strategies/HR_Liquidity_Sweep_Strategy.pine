//@version=6
strategy("HR Liquidity Sweep Reversal Pro [Strategy]", 
         shorttitle="HR-SWP-S", 
         overlay=true, 
         initial_capital=10000, 
         default_qty_type=strategy.percent_of_equity, 
         default_qty_value=1.0, 
         commission_type=strategy.commission.percent, 
         commission_value=0.02, 
         slippage=2, 
         process_orders_on_close=true, 
         max_labels_count=500, 
         max_lines_count=500)

// =============================================================================
// HR LIQUIDITY SWEEP REVERSAL PRO — DEDICATED PINE SCRIPT V6 STRATEGY
// Product ID: HR-PRD-02
// System: HR TradingView Suite | ScaleNova / HR Professional Services
// Author: Hemanth Ranam | Developed by Antigravity Engine
//
// ALIGNMENT SPECIFICATION:
//   - Directly shares signal calculation engine with HR_Liquidity_Sweep_Indicator.pine
//   - Aligned with MT5 EA: LIQUIDITY_SWEEP_REVERSAL_EA.mq5
//   - Enforces closed-bar execution (process_orders_on_close=true, barstate.isconfirmed)
//   - Structural Stop Loss placed at sweep wick extreme with configurable ATR buffer
//   - Target R:R ratio defaults to 1:2.5 matching MT5 InpRewardToRiskRatio
//
// RISK GUARDRAIL:
//   - Maximum risk per trade capped at 1.0% account equity
//   - Explicit commission (0.02%) and slippage (2 ticks) modeled
// =============================================================================

// ─────────────────────────────────────────────────────────────────────────────
// INPUT GROUPS
// ─────────────────────────────────────────────────────────────────────────────
var string GRP_GEN    = "● General Execution"
var string GRP_SWEEP  = "● Liquidity Sweep Parameters"
var string GRP_CONF   = "● Rejection & Displacement Confirmation"
var string GRP_SESS   = "● Session Filter & Timezones"
var string GRP_HTF    = "● Higher-Timeframe Filter"
var string GRP_SCORE  = "● Signal Quality Scoring"
var string GRP_RISK   = "● Risk Management & Targets"
var string GRP_DASH   = "● Telemetry Dashboard"
var string GRP_VIS    = "● Visual Settings"

// ─── GENERAL EXECUTION ───────────────────────────────────────────────────────
enableLong     = input.bool(true,  "Enable Long Trades",             group=GRP_GEN,
     tooltip="Permits strategy to enter Long positions on confirmed Bullish Sweeps.")
enableShort    = input.bool(true,  "Enable Short Trades",            group=GRP_GEN,
     tooltip="Permits strategy to enter Short positions on confirmed Bearish Sweeps.")
useDateFilter  = input.bool(false, "Enable Testing Date Filter",     group=GRP_GEN)
startDate      = input.time(timestamp("2024-01-01 00:00:00"), "Start Date", group=GRP_GEN)
endDate        = input.time(timestamp("2026-12-31 23:59:59"), "End Date",   group=GRP_GEN)

// ─── LIQUIDITY SWEEP PARAMETERS ──────────────────────────────────────────────
lookbackBars    = input.int(24,   "Swing Lookback Window (Bars)", minval=5, maxval=100, group=GRP_SWEEP,
     tooltip="Number of prior bars evaluated to identify the liquidity reference extreme. Aligned with MT5 EA InpSwingLookbackBars=24.")
useAtrSweepNorm = input.bool(true, "Use ATR Normalized Sweep Depth", group=GRP_SWEEP)
minSweepAtr     = input.float(0.1, "Min Sweep Penetration (× ATR)", minval=0.01, step=0.05, group=GRP_SWEEP)
maxSweepAtr     = input.float(2.5, "Max Sweep Penetration (× ATR)", minval=0.5, step=0.1, group=GRP_SWEEP)

// ─── REJECTION & DISPLACEMENT CONFIRMATION ────────────────────────────────────
minDisplacementR = input.float(0.50, "Min Displacement Ratio (0.0–1.0)", minval=0.1, maxval=0.9, step=0.05, group=GRP_CONF,
     tooltip="Proportion of bar range in the reversal direction. Bullish: (Close - Low) / Range. Bearish: (High - Close) / Range. MT5 default: 0.50.")
requireCloseInside = input.bool(true, "Require Candle Close Inside Level", group=GRP_CONF)
requireOpposingColor = input.bool(false, "Require Reversal Candle Color", group=GRP_CONF)

// ─── SESSION FILTER & TIMEZONES ──────────────────────────────────────────────
useSessionFilter = input.bool(false, "Enable Session Timing Filter", group=GRP_SESS)
prefSessions     = input.string("London + NY", "Session Window",
     options=["All Active Sessions", "London Only", "New York Only", "London + NY", "Off — Custom"], group=GRP_SESS)
customSession    = input.session("0800-2200:23456", "Custom Session Window", group=GRP_SESS)
tzOffset         = input.int(0, "Timezone UTC Offset (Hours)", minval=-12, maxval=14, group=GRP_SESS)

// ─── HIGHER-TIMEFRAME FILTER ─────────────────────────────────────────────────
useHtfFilter = input.bool(false, "Enable HTF Macro Trend Filter", group=GRP_HTF)
htfTF        = input.timeframe("60", "Higher Timeframe", group=GRP_HTF)
htfEmaLen    = input.int(200, "HTF Baseline EMA", minval=10, group=GRP_HTF)

// ─── SIGNAL QUALITY SCORING ──────────────────────────────────────────────────
minEntryScore  = input.int(70, "Minimum Entry Quality Score (0–100)", minval=50, maxval=95, step=5, group=GRP_SCORE)
minSignalGrade = input.string("A and Above", "Minimum Signal Grade",
     options=["A+ Only", "A and Above", "B and Above", "All Signals"], group=GRP_SCORE)

// ─── RISK MANAGEMENT & TARGETS ───────────────────────────────────────────────
atrLen       = input.int(14,    "ATR Period", minval=1, group=GRP_RISK)
slBufferAtr  = input.float(0.2,  "Protective SL Buffer (× ATR)", minval=0.0, step=0.05, group=GRP_RISK,
     tooltip="Protective buffer added beyond the sweep wick extreme.")
rrMultiplier = input.float(2.5,  "Target Reward-to-Risk (R:R)", minval=1.0, step=0.1, group=GRP_RISK,
     tooltip="Target R:R ratio. Aligned with MT5 InpRewardToRiskRatio=2.5.")
cooldownBars = input.int(5,      "Minimum Cooldown Bars", minval=1, maxval=50, group=GRP_RISK)

// ─── DASHBOARD & VISUALS ─────────────────────────────────────────────────────
showHud         = input.bool(true,  "Display Telemetry HUD",       group=GRP_DASH)
hudPos          = input.string("Top Right", "HUD Position",
     options=["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group=GRP_DASH)
showLevels      = input.bool(true,  "Plot Swing Liquidity Levels", group=GRP_VIS)
showTradeLabels = input.bool(true,  "Show Entry Markers",          group=GRP_VIS)

// =============================================================================
// CALCULATIONS & INDICATOR VALUES
// =============================================================================
atr = ta.atr(atrLen)
candleRange = math.max(high - low, syminfo.mintick)

// Higher-Timeframe Security Request (Strict [1] indexing and lookahead_off)
htfClose  = request.security(syminfo.tickerid, htfTF, close[1], barmerge.gaps_off, barmerge.lookahead_off)
htfEma200 = request.security(syminfo.tickerid, htfTF, ta.ema(close, htfEmaLen)[1], barmerge.gaps_off, barmerge.lookahead_off)
htfBullOk = not useHtfFilter or (htfClose > htfEma200)
htfBearOk = not useHtfFilter or (htfClose < htfEma200)

// Reference Swing Levels
swingHigh = ta.highest(high[1], lookbackBars)
swingLow  = ta.lowest(low[1],   lookbackBars)

// Session Detection
var string tz = "UTC"
if tzOffset != 0
    tz := str.format("UTC{0}{1}", tzOffset >= 0 ? "+" : "-", math.abs(tzOffset))

is_ny  = math.sign(nz(time(timeframe.period, "1300-2200", tz)))
is_ldn = math.sign(nz(time(timeframe.period, "0700-1600", tz)))
is_tyo = math.sign(nz(time(timeframe.period, "0000-0900", tz)))
is_cus = not na(time(timeframe.period, customSession))

sessionAllowed = not useSessionFilter or switch prefSessions
    "London Only"         => is_ldn > 0
    "New York Only"       => is_ny  > 0
    "London + NY"         => (is_ldn > 0) or (is_ny > 0)
    "All Active Sessions" => (is_ny > 0) or (is_ldn > 0) or (is_tyo > 0)
    "Off — Custom"        => is_cus
    => true

sessionName = is_ldn > 0 ? "London" : is_ny > 0 ? "New York" : is_tyo > 0 ? "Tokyo" : "Off-Hours"

// Sweep & Reclaim Conditions
sweepLowDepth    = swingLow - low
sweepLowDepthAtr = atr > 0 ? (sweepLowDepth / atr) : 0.0
validBullDepth   = sweepLowDepthAtr >= minSweepAtr and sweepLowDepthAtr <= maxSweepAtr
bullDisplacement = (close - low) / candleRange
bullDisplaceOk   = bullDisplacement >= minDisplacementR
bullColorOk      = not requireOpposingColor or (close > open)
bullReclaimOk    = not requireCloseInside or (close > swingLow)

sweepHighDepth    = high - swingHigh
sweepHighDepthAtr = atr > 0 ? (sweepHighDepth / atr) : 0.0
validBearDepth    = sweepHighDepthAtr >= minSweepAtr and sweepHighDepthAtr <= maxSweepAtr
bearDisplacement  = (high - close) / candleRange
bearDisplaceOk    = bearDisplacement >= minDisplacementR
bearColorOk       = not requireOpposingColor or (close < open)
bearReclaimOk     = not requireCloseInside or (close < swingHigh)

dateWindowOk = not useDateFilter or (time >= startDate and time <= endDate)

rawBullSweep = enableLong and (low < swingLow) and bullReclaimOk and validBullDepth and 
               bullDisplaceOk and bullColorOk and sessionAllowed and htfBullOk and barstate.isconfirmed and dateWindowOk

rawBearSweep = enableShort and (high > swingHigh) and bearReclaimOk and validBearDepth and 
               bearDisplaceOk and bearColorOk and sessionAllowed and htfBearOk and barstate.isconfirmed and dateWindowOk

// Quality Scoring Engine
calcQualityScore(isBull) =>
    float s = 0.0
    float disp = isBull ? bullDisplacement : bearDisplacement
    float depthAtr = isBull ? sweepLowDepthAtr : sweepHighDepthAtr
    s += disp >= 0.70 ? 35.0 : disp >= 0.55 ? 25.0 : disp >= 0.40 ? 15.0 : 5.0
    s += (depthAtr >= 0.25 and depthAtr <= 1.20) ? 25.0 : (depthAtr <= 2.0) ? 15.0 : 5.0
    s += (is_ldn > 0 or is_ny > 0) ? 20.0 : sessionAllowed ? 10.0 : 0.0
    s += isBull ? (htfClose > htfEma200 ? 20.0 : 0.0) : (htfClose < htfEma200 ? 20.0 : 0.0)
    math.min(100.0, s)

bullScore = calcQualityScore(true)
bearScore = calcQualityScore(false)

getGrade(score) =>
    score >= 90.0 ? "A+" : score >= 75.0 ? "A" : score >= 60.0 ? "B" : "C"

bullGrade = getGrade(bullScore)
bearGrade = getGrade(bearScore)

isGradeAllowed(grade) =>
    switch minSignalGrade
        "A+ Only"     => grade == "A+"
        "A and Above" => grade == "A+" or grade == "A"
        "B and Above" => grade == "A+" or grade == "A" or grade == "B"
        => true

// Cooldown & Single Entry Gate
var int lastBullBar = -100
var int lastBearBar = -100

canBull = (bar_index - lastBullBar) >= cooldownBars
canBear = (bar_index - lastBearBar) >= cooldownBars

buySignal  = rawBullSweep and canBull and (bullScore >= minEntryScore) and isGradeAllowed(bullGrade)
sellSignal = rawBearSweep and canBear and (bearScore >= minEntryScore) and isGradeAllowed(bearGrade)

if buySignal
    lastBullBar := bar_index
if sellSignal
    lastBearBar := bar_index

// =============================================================================
// ORDER EXECUTION & RISK MANAGEMENT
// =============================================================================
var float entryPrice = na
var float slPrice    = na
var float tpPrice    = na

longCondition  = buySignal  and strategy.position_size == 0
shortCondition = sellSignal and strategy.position_size == 0

if longCondition
    entryPrice   := close
    slPrice      := low - (atr * slBufferAtr)
    riskDistance = entryPrice - slPrice
    tpPrice      := entryPrice + (riskDistance * rrMultiplier)
    
    strategy.entry("HR_Long", strategy.long)
    strategy.exit("Exit_Long", "HR_Long", stop=slPrice, limit=tpPrice)
    
    if showTradeLabels
        label.new(bar_index, low - (atr * 0.4), "BUY SWEEP\n" + bullGrade + " (" + str.tostring(bullScore, "#") + ")",
                  color=#2563eb, textcolor=color.white, style=label.style_label_up, size=size.small)
                  
    alert('{"brand":"Hemanth Ranam","system":"TradingView","strategy":"Liquidity Sweep Reversal Pro","signal":"BUY","symbol":"' + syminfo.ticker + '","timeframe":"' + timeframe.period + '","entry":' + str.tostring(entryPrice, "#.##") + ',"stop_loss":' + str.tostring(slPrice, "#.##") + ',"take_profit_1":' + str.tostring(tpPrice, "#.##") + ',"score":' + str.tostring(bullScore, "#") + ',"grade":"' + bullGrade + '","timestamp":' + str.tostring(time) + '}', alert.freq_once_per_bar_close)

if shortCondition
    entryPrice   := close
    slPrice      := high + (atr * slBufferAtr)
    riskDistance = slPrice - entryPrice
    tpPrice      := entryPrice - (riskDistance * rrMultiplier)
    
    strategy.entry("HR_Short", strategy.short)
    strategy.exit("Exit_Short", "HR_Short", stop=slPrice, limit=tpPrice)
    
    if showTradeLabels
        label.new(bar_index, high + (atr * 0.4), "SELL SWEEP\n" + bearGrade + " (" + str.tostring(bearScore, "#") + ")",
                  color=#dc2626, textcolor=color.white, style=label.style_label_down, size=size.small)
                  
    alert('{"brand":"Hemanth Ranam","system":"TradingView","strategy":"Liquidity Sweep Reversal Pro","signal":"SELL","symbol":"' + syminfo.ticker + '","timeframe":"' + timeframe.period + '","entry":' + str.tostring(entryPrice, "#.##") + ',"stop_loss":' + str.tostring(slPrice, "#.##") + ',"take_profit_1":' + str.tostring(tpPrice, "#.##") + ',"score":' + str.tostring(bearScore, "#") + ',"grade":"' + bearGrade + '","timestamp":' + str.tostring(time) + '}', alert.freq_once_per_bar_close)

// =============================================================================
// PLOTS & TELEMETRY HUD
// =============================================================================
plot(showLevels ? swingHigh : na, "Swing High Liquidity", color=color.new(#ef4444, 40), linewidth=1, style=plot.style_stepline)
plot(showLevels ? swingLow  : na, "Swing Low Liquidity",  color=color.new(#22c55e, 40), linewidth=1, style=plot.style_stepline)

if showHud and barstate.islast
    tablePos = hudPos == "Top Right"    ? position.top_right : 
               hudPos == "Bottom Right" ? position.bottom_right : 
               hudPos == "Top Left"     ? position.top_left : position.bottom_left
               
    var table hud = table.new(tablePos, 2, 7, bgcolor=color.new(#0f172a, 15), border_color=color.new(#334155, 30), border_width=1)
    
    table.cell(hud, 0, 0, "HEMANTH RANAM", bgcolor=color.new(#1e293b, 10), text_color=#38bdf8, text_size=size.small)
    table.cell(hud, 1, 0, "SWEEP REVERSAL STRAT", bgcolor=color.new(#1e293b, 10), text_color=color.white, text_size=size.small)
    
    table.cell(hud, 0, 1, "Swing High", text_color=#94a3b8, text_size=size.tiny)
    table.cell(hud, 1, 1, str.tostring(swingHigh, "#.##"), text_color=#ef4444, text_size=size.tiny)
    
    table.cell(hud, 0, 2, "Swing Low", text_color=#94a3b8, text_size=size.tiny)
    table.cell(hud, 1, 2, str.tostring(swingLow, "#.##"), text_color=#22c55e, text_size=size.tiny)
    
    table.cell(hud, 0, 3, "Active Session", text_color=#94a3b8, text_size=size.tiny)
    table.cell(hud, 1, 3, sessionName, text_color=sessionAllowed ? #22c55e : #94a3b8, text_size=size.tiny)
    
    table.cell(hud, 0, 4, "Open Position", text_color=#94a3b8, text_size=size.tiny)
    table.cell(hud, 1, 4, strategy.position_size > 0 ? "LONG (" + str.tostring(strategy.position_size) + ")" : 
                          strategy.position_size < 0 ? "SHORT (" + str.tostring(strategy.position_size) + ")" : "FLAT", 
               text_color=strategy.position_size != 0 ? #f59e0b : #94a3b8, text_size=size.tiny)
               
    table.cell(hud, 0, 5, "Setup Score", text_color=#94a3b8, text_size=size.tiny)
    table.cell(hud, 1, 5, str.tostring(math.max(bullScore, bearScore), "#") + " (" + (bullScore > bearScore ? bullGrade : bearGrade) + ")", 
               text_color=#38bdf8, text_size=size.tiny)
               
    table.cell(hud, 0, 6, "Win Rate (Sim)", text_color=#94a3b8, text_size=size.tiny)
    float winRate = strategy.closedtrades > 0 ? (strategy.wintrades / strategy.closedtrades * 100.0) : 0.0
    table.cell(hud, 1, 6, strategy.closedtrades > 0 ? str.tostring(winRate, "#.#") + "% (" + str.tostring(strategy.closedtrades) + " tr)" : "N/A", 
               text_color=color.white, text_size=size.tiny)
